Options -Indexes
ErrorDocument 404 /404.html

RewriteEngine On

# www.odinsbane.com -> odinsbane.com (HTTPS itself is forced by hPanel's "Force HTTPS")
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Old WordPress URLs
RewriteRule ^home-2-2/?$ /free-stories/jotunheist/ [L,R=301]
RewriteRule ^home-2/?$ /free-stories/witchblade/ [L,R=301]

# Repo files that shouldn't be served
RewriteRule ^(README\.md|tools/|\.git) - [R=404,L]

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
